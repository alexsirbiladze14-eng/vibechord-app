# Copy this file to .env.local (which is gitignored, so your real key
# never gets committed) and paste your actual Anthropic API key in.
#
# Get a key at https://console.anthropic.com — Settings > API Keys.

ANTHROPIC_API_KEY=your-key-here

# ---- Week 9: Supabase (accounts + database) ----
# Get these from your Supabase project: Settings > API.
# NEXT_PUBLIC_ vars are safe to expose to the browser (that's what
# NEXT_PUBLIC_ means to Next.js) — the anon key is designed for this,
# and Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER expose this one. Server-only — used just once, in the Stripe
# webhook route, to credit accounts after a verified payment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Week 9: Lemon Squeezy (billing) ----
# See BILLING.md for exact setup steps (creating products, getting
# your store ID and API key, and the webhook endpoint).
LEMONSQUEEZY_API_KEY=your-api-key-here
LEMONSQUEEZY_STORE_ID=your-store-id-here
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret-here

# Variant IDs from products you create in the Lemon Squeezy dashboard —
# these are NOT secret, but they're specific to your store, so there's
# nothing to fill in here until you've created them.
LEMONSQUEEZY_VARIANT_HOBBYIST=your-variant-id-here
LEMONSQUEEZY_VARIANT_PRO=your-variant-id-here
LEMONSQUEEZY_VARIANT_PACK_SMALL=your-variant-id-here
LEMONSQUEEZY_VARIANT_PACK_MEDIUM=your-variant-id-here
LEMONSQUEEZY_VARIANT_PACK_LARGE=your-variant-id-here

